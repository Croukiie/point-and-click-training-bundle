* text=auto

# Source files executed on Linux/Yonsei must keep LF line endings.
*.py text eol=lf
*.sh text eol=lf
*.slurm text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows launchers remain native to Windows.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Generated and model artifacts are binary.
*.gz binary
*.npy binary
*.npz binary
*.pkl binary
*.png binary
*.pt binary
*.tar binary
*.zip binary
